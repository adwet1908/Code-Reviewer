# Copy to backend/.env (or the repo root) and fill in values.
# Never commit the real .env.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Create an empty database named code_reviewer in pgAdmin first.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Use docker compose (pgvector). Plain pgAdmin Postgres lacks the vector extension.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/code_reviewer
# SKIP_DB_MIGRATE=true
# DB_CONNECT_TIMEOUT=10

# Long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string-32b+
JWT_EXPIRE_MINUTES=10080

# Phase 2 embeddings (gemini-embedding-001, 768d for pgvector HNSW)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# Phase 3 agentic pipeline
AGENT_LLM_CALL_BUDGET=10
AGENT_NODE_TIMEOUT_SECONDS=90
AGENT_EVIDENCE_MAX_CHARS=24000
AGENT_CHEAP_MODEL=gemini-3.8-flash
AGENT_STRONG_MODEL=gemini-2.5-pro
